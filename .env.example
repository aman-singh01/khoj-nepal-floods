# ---------------------------------------------------------------------------
# Khoj - environment configuration
# Copy to .env.local for local development. Set these in your host (Vercel) for
# production.
# ---------------------------------------------------------------------------

# Database.
#  - Leave UNSET (or "pglite") for a zero-setup local Postgres (data in ./.pglite).
#  - For production, set a real Postgres connection string, e.g. Neon / Supabase:
#      DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require
DATABASE_URL=

# Secret used to hash submitter IP addresses before storing them (rate limiting
# + abuse tracing). Any long random string. CHANGE THIS.
IP_HASH_SALT=dev-only-change-me

# Shared secret that unlocks the /moderation queue AND the feed import endpoint
# (POST /api/pfif/import, sent as the `x-khoj-token` header). Anyone with this
# can approve/hide records and ingest external data, so treat it like a
# password. For a real deployment, replace with proper accounts.
MODERATION_TOKEN=dev-moderator-token

# Photo storage. If a Vercel Blob token is present, photos go there; otherwise
# they are written to ./public/uploads (fine for local dev, NOT for production
# on serverless hosts where the filesystem is ephemeral).
BLOB_READ_WRITE_TOKEN=

# Public base URL, used in PFIF exports so other trackers can link back.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Days a record stays public before it is considered expired (data retention).
RECORD_TTL_DAYS=180

# Secret for the event-updates refresh endpoint (POST/GET /api/updates/refresh),
# sent by a scheduler as the `authorization` header. Vercel Cron uses this too.
# If unset, that endpoint still accepts the MODERATION_TOKEN or a moderator
# cookie. The /updates and home pages also self-refresh on view, so a scheduler
# is optional.
CRON_SECRET=
